<%- include('../partials/header', { title: 'Find Flights - SkyConnect' }) %>
<div class="container py-5">
    <h1 class="display-4 fw-800 text-dark mb-4">Explore Destinations</h1>
    <div class="row g-4">
        <% airports.forEach(airport => { %>
            <div class="col-md-4">
                <div class="card p-4 border-0 shadow-sm">
                    <h5 class="fw-bold mb-1"><%= airport.city %> (<%= airport.code %>)</h5>
                    <p class="text-secondary small mb-0"><%= airport.name %></p>
                </div>
            </div>
        <% }) %>
    </div>
</div>
<%- include('../partials/footer') %>
