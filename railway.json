{
  "build": {
    "install": "composer install --no-dev --prefer-dist --no-interaction",
    "build": "npm install && npm run build"
  },
  "start": "php artisan serve --host=0.0.0.0 --port=$PORT",
  "env": {
    "APP_ENV": "production",
    "APP_DEBUG": "false",
    "APP_KEY": "generate",
    "LOG_LEVEL": "info"
  },
  "services": {
    "database": {
      "type": "mysql",
      "version": "8.0"
    }
  }
}
